---
import Base from '../layouts/Base.astro';
---

<Base title="Chris Thomas — a house of ideas">
  <main class="porch">

    <header class="porch-header">
      <span class="mono site-name">Chris Thomas</span>
    </header>

    <a href="/hall" class="front-door" aria-label="Enter the house">
      <div class="door-light" aria-hidden="true"></div>
      <div class="door-panel">
        <span class="door-knob" aria-hidden="true"></span>
      </div>
      <div class="sill" aria-hidden="true"></div>
    </a>

    <footer class="porch-footer">
      <p class="mono enter-hint">enter</p>
    </footer>

  </main>
</Base>

<style>
  .porch {
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    place-items: center;
    padding: 2rem;
    position: relative;
    overflow: hidden;
  }

  /* Warm light from above the door — a porch lamp, breathing. */
  .porch::before {
    content: '';
    position: fixed;
    top: 32%;
    left: 50%;
    translate: -50% -50%;
    width: 60vw;
    height: 55vh;
    background: radial-gradient(ellipse,
      rgba(200, 152, 64, 0.07) 0%, transparent 68%);
    pointer-events: none;
    z-index: 0;
    animation: porch-breathe 16s ease-in-out infinite;
  }

  @keyframes porch-breathe {
    0%, 100% { opacity: 0.7; transform: translate(-50%, -50%) scale(1); }
    50%      { opacity: 1;   transform: translate(-50%, -52%) scale(1.05); }
  }

  .porch-header {
    align-self: start;
    padding-top: 1rem;
    position: relative;
    z-index: 1;
  }
  .site-name {
    font-size: 0.65rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ── The front door ── */
  .front-door {
    position: relative;
    z-index: 1;
    width: clamp(180px, 42vw, 240px);
    aspect-ratio: 5 / 9;
    border: 1px solid rgba(200, 152, 64, 0.22);
    background: linear-gradient(180deg,
      rgba(200, 152, 64, 0.03) 0%,
      rgba(200, 152, 64, 0.07) 100%);
    text-decoration: none;
    display: block;
    overflow: visible;
    view-transition-name: front-door;
    transition:
      border-color 0.7s var(--ease-drift),
      box-shadow   0.7s var(--ease-drift),
      transform    0.7s var(--ease-drift);
  }

  /* Light leaking from above + around the door, blooms on approach. */
  .door-light {
    position: absolute;
    inset: -2px;
    background: radial-gradient(ellipse 90% 50% at 50% 0%,
      rgba(200, 152, 64, 0.18) 0%, transparent 65%);
    opacity: 0.4;
    transition: opacity 0.8s var(--ease-drift);
    pointer-events: none;
  }

  .door-panel {
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(200, 152, 64, 0.10);
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  .door-knob {
    width: 7px;
    height: 7px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--color-gold-dim);
    box-shadow: 0 0 8px rgba(200, 152, 64, 0.4);
    transition: background 0.5s var(--ease-drift), box-shadow 0.5s var(--ease-drift);
  }

  /* Warm light spilling from under the door onto the floor. */
  .sill {
    position: absolute;
    left: 50%;
    bottom: -26px;
    translate: -50% 0;
    width: 150%;
    height: 40px;
    background: radial-gradient(ellipse 60% 100% at 50% 0%,
      rgba(200, 152, 64, 0.16) 0%, transparent 72%);
    pointer-events: none;
  }

  .front-door:hover,
  .front-door:focus-visible {
    border-color: rgba(200, 152, 64, 0.5);
    box-shadow: 0 0 70px rgba(200, 152, 64, 0.06);
    outline: none;
  }
  .front-door:hover .door-light,
  .front-door:focus-visible .door-light { opacity: 1; }
  .front-door:hover .door-knob,
  .front-door:focus-visible .door-knob {
    background: var(--color-gold);
    box-shadow: 0 0 12px rgba(200, 152, 64, 0.7);
  }

  /* ── Footer hint ── */
  .porch-footer {
    align-self: end;
    padding-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }
  .enter-hint {
    font-size: 0.62rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    text-indent: 0.4em;
    color: var(--color-text-muted);
    animation: hint-pulse 4s ease-in-out infinite;
  }
  @keyframes hint-pulse {
    0%, 100% { opacity: 0.4; }
    50%      { opacity: 0.85; }
  }
</style>
