---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const all = await getCollection('posts', ({ data }) => !data.draft);
const posts = all
  .filter(p => p.data.room === 'workshop')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
}
---

<Base title="The Workshop — Chris Thomas" description="Product work, things I build, tech writing.">
  <main class="room">
    <a href="/hall" class="back mono">← hallway</a>

    <header class="room-header" style="view-transition-name: door-workshop">
      <h1 class="room-name mono">The Workshop</h1>
      <p class="mono room-intro">product work. things built. how the systems actually run.</p>
    </header>

    {posts.length === 0 ? (
      <p class="empty mono enter">nothing on the bench yet.</p>
    ) : (
      <ul class="post-list enter">
        {posts.map(post => (
          <li class="post-item">
            <a href={`/workshop/${post.id}`} class="post-link">
              <p class="mono post-meta">
                {fmtDate(post.data.date)}
                {post.data.tags.length > 0 && <span class="tags"> · {post.data.tags.join(', ')}</span>}
              </p>
              <h2 class="post-title mono">{post.data.title}</h2>
              <p class="post-excerpt">{post.data.excerpt}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Base>

<style>
  .room {
    max-width: 680px;
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
  }

  /* The Workshop's air — a flat, even work-light from above. Functional,
     not atmospheric: the bench is simply lit. */
  .room::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse 90% 55% at 68% -4%,
      rgba(200, 152, 64, 0.035) 0%, transparent 72%);
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 3rem;
    transition: color 0.3s var(--ease-drift);
  }

  .back:hover { color: var(--color-gold); opacity: 1; }

  .room-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  /* Workshop: heading is mono, not serif */
  .room-name {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .room-intro {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    max-width: 52ch;
  }

  .empty { color: var(--color-text-muted); font-size: 0.75rem; letter-spacing: 0.1em; }

  .post-list { list-style: none; }

  .post-item { border-bottom: 1px solid var(--color-border); }

  .post-link {
    display: block;
    padding: 2rem 0;
    color: inherit;
    transition: none;
  }

  .post-link:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .post-link:hover .post-title { color: var(--color-gold); }

  .post-meta {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  .tags { text-transform: none; letter-spacing: 0.04em; }

  /* Workshop post titles are monospace */
  .post-title {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.02em;
    margin-bottom: 0.65rem;
    color: var(--color-text);
    transition: color 0.3s var(--ease-drift);
  }

  .post-excerpt {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    max-width: 62ch;
    font-family: var(--font-serif);
  }
</style>
