---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts
    .filter(p => p.data.room === 'long-room')
    .map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateStr = post.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
---

<Base title={`${post.data.title} — Chris Thomas`} description={post.data.excerpt}>
  <article class="post-article">
    <a href="/long-room" class="back mono">← the long room</a>

    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta mono">
        <span class="date">{dateStr}</span>
        {post.data.tags.length > 0 && (
          <span class="tags">
            {post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
          </span>
        )}
      </div>
    </header>

    <hr class="divider" />

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post-article {
    max-width: 620px;
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 3rem;
    opacity: 0.7;
    transition: opacity 0.3s var(--ease-drift);
  }

  .back:hover { opacity: 1; color: var(--color-gold-dim); }

  .post-title {
    font-size: clamp(1.6rem, 4.5vw, 2.4rem);
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--color-text);
    opacity: 0.85;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  .tags { display: flex; gap: 0.5rem; text-transform: none; letter-spacing: 0.04em; }

  .tag {
    border: 1px solid rgba(46, 42, 36, 0.8);
    padding: 2px 8px;
    border-radius: 2px;
    font-size: 0.65rem;
    color: var(--color-text-muted);
  }

  .divider {
    border: none;
    border-top: 1px solid rgba(46, 42, 36, 0.8);
    margin: 2rem 0 2.5rem;
  }

  .prose {
    font-size: 1.05rem;
    line-height: 1.95;
    color: var(--color-text-muted);
    opacity: 0.9;
  }

  .prose :global(p) { margin-bottom: 1.75em; max-width: 60ch; }

  /* Drop cap — quieter than Study, dimmer gold */
  .prose :global(p:first-of-type::first-letter) {
    font-family: var(--font-serif);
    font-size: 3.2em;
    font-weight: 400;
    float: left;
    line-height: 0.82;
    margin-right: 0.08em;
    margin-top: 0.06em;
    color: var(--color-gold-dim);
  }
  .prose :global(p:last-child) { margin-bottom: 0; }
  .prose :global(em) { color: var(--color-text); font-style: italic; }
  .prose :global(strong) { color: var(--color-text); font-weight: 600; }
  .prose :global(a) { color: var(--color-gold-dim); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(blockquote) {
    border-left: 1px solid var(--color-gold-dim);
    padding-left: 1.25rem;
    margin: 1.75em 0;
    font-style: italic;
    opacity: 0.8;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-text-muted);
    background: var(--color-surface);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }
</style>
